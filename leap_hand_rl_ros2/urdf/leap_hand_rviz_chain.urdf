<?xml version="1.0"?>
<!-- Minimal kinematic chain for RViz: joint names match Isaac task actuated_joint_names (a_0..a_15). -->
<!-- Replace with meshes from leap-hand/LEAP_Hand_Sim if you need accurate geometry. -->
<robot name="leap_hand_rviz">
  <link name="world"/>
  <link name="base_link">
    <visual><geometry><box size="0.04 0.08 0.02"/></geometry></visual>
  </link>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Sequential chain for TF; purely for motion debugging (not anatomically exact). -->
  <joint name="a_0" type="revolute">
    <parent link="base_link"/>
    <child link="link_0"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="1" velocity="10"/>
  </joint>
  <link name="link_0"/>

  <joint name="a_1" type="revolute">
    <parent link="link_0"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="1" velocity="10"/>
  </joint>
  <link name="link_1"/>

